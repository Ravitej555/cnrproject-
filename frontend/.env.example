# AQI City Search — API Token
# Get your FREE token at: https://aqicn.org/api/
# The 'demo' token works for testing but is rate-limited.
# Replace with your personal token for production use.
VITE_AQI_TOKEN=demo

# Render Backend API URL (Leave blank or http://127.0.0.1:8000 for local dev)
# Example production Render URL:
# VITE_API_URL=https://smart-health-backend.onrender.com
VITE_API_URL=http://127.0.0.1:8000
